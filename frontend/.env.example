# Opcional: endereço do backend (sem /api no final). Por padrão é o mesmo endereço
# por onde a página foi aberta, na porta 9000 (funciona no localhost e no celular).
# NEXT_PUBLIC_BASEURL=http://localhost:9000

# Opcional: por padrão é o NEXT_PUBLIC_BASEURL com ws:// no lugar de http://
# NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:9000

# Opcional: servidores STUN/TURN para as chamadas, em JSON. Padrão: STUN público do Google.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.exemplo.com:3478","username":"u","credential":"s"}]
